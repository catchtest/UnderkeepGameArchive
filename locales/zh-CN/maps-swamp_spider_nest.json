  "maps.points.swamp_spider_nest.l15.detail.item-links": "[[18,20,\"item_sword_of_striking\"],[27,29,\"item_coins\"],[43,48,\"item_bones01\"],[54,62,\"item_bones02\"],[68,70,\"item_bones03\"],[76,84,\"item_bones04\"],[90,92,\"item_bones05\"],[106,108,\"item_empty_flask\"],[109,114,\"item_food_bread_mold\"],[115,121,\"item_minor_endurance_potion\"],[122,128,\"item_minor_heal_potion\"],[129,135,\"item_minor_mana_potion\"],[136,140,\"item_rusty_sword\"]]",
  "maps.points.swamp_spider_nest.l22.detail": "守御药剂、火辉戒指",
